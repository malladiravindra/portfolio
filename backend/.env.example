# Copy this file to .env and fill in real values. Never commit the real .env.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend origin(s) allowed to call this API (comma-separated, no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database — optional. If unset, falls back to a local SQLite file.
# Example for Postgres: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

